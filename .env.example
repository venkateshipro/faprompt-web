# ───────────────────────────────────────────────────────────────
# FaPrompt frontend — environment
# Copy this file to `.env.local` and fill in your values.
# ───────────────────────────────────────────────────────────────

# WordPress GraphQL endpoint (headless backend).
# Production:  https://cms.faprompt.com/graphql
# Local WP:    http://localhost:8080/graphql
# Leave blank/unset to run the site on built-in fallback content (no WP needed).
WP_GRAPHQL_ENDPOINT=https://cms.faprompt.com/graphql

# Hostname that serves WordPress media (for next/image optimization).
NEXT_PUBLIC_WP_IMAGE_HOST=cms.faprompt.com

# Public site URL (used for canonical URLs, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL=https://faprompt.com

# Optional: secret used by the on-demand revalidation webhook (Phase 5).
REVALIDATE_SECRET=change-me-to-a-long-random-string

# ───────────────────────────────────────────────────────────────
# Contact form — Hostinger SMTP (Nodemailer)
# ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@faprompt.com
SMTP_PASS=ammu123FAPVK@
CONTACT_TO=hello@faprompt.com
CONTACT_FROM=hello@faprompt.com
